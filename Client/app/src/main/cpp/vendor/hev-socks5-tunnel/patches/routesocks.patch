diff --git a/src/hev-flow-classifier.c b/src/hev-flow-classifier.c
new file mode 100644
index 0000000..7cfb089
--- /dev/null
+++ b/src/hev-flow-classifier.c
@@ -0,0 +1,69 @@
+#include "hev-flow-classifier.h"
+
+#include <string.h>
+
+static HevFlowClassifier flow_classifier;
+static uint16_t selected_socks_port;
+
+/*
+ * 在 Java 启动 Native 数据面时登记五元组分类回调和选中应用入口端口。
+ * HEV 会话线程只读取这两个值；调用方必须在 HEV 接收 TUN 流量前完成登记。
+ */
+void
+hev_socks5_tunnel_set_flow_classifier (HevFlowClassifier classifier,
+                                        uint16_t selected_port)
+{
+    flow_classifier = classifier;
+    selected_socks_port = selected_port;
+}
+
+/*
+ * 把 lwIP 地址复制到稳定的 16 字节跨 SO 结构；IPv4 仅使用前四字节，其余清零。
+ * 输入地址由会话 PCB 持有且仅在当前调用有效，输出由调用者提供。
+ */
+static void
+copy_address (const ip_addr_t *address, uint8_t *output)
+{
+    memset (output, 0, 16);
+    if (IP_IS_V6 (address))
+        memcpy (output, ip_2_ip6 (address), 16);
+    else
+        memcpy (output, ip_2_ip4 (address), 4);
+}
+
+/*
+ * 在 lwIP 仍保留应用源端点的位置完成一次 UID 归属分类。
+ * lwIP 在 tcp_input/udp_input 入口已经把报文端口转换成主机序，跨 SO 结构保持该语义，
+ * 由 JNI 桥接再编码为稳定网络序；重复 ntohs 会在 ARM 小端机器把 443 变成 47873。
+ * 未登记回调表示单作用域配置并选择全局入口；分类器返回负数时上层丢弃会话。
+ */
+int
+hev_flow_classify (uint8_t protocol, const ip_addr_t *source,
+                   uint16_t source_port, const ip_addr_t *destination,
+                   uint16_t destination_port)
+{
+    HevFlowTuple tuple;
+
+    if (!flow_classifier)
+        return 0;
+
+    memset (&tuple, 0, sizeof (tuple));
+    tuple.protocol = protocol;
+    tuple.family = IP_IS_V6 (source) ? 6 : 4;
+    tuple.source_port = source_port;
+    tuple.destination_port = destination_port;
+    copy_address (source, tuple.source_address);
+    copy_address (destination, tuple.destination_address);
+
+    return flow_classifier (&tuple);
+}
+
+/*
+ * 返回选中应用专用 SOCKS 入口端口；零值只会出现在启动契约被破坏时，
+ * 会话层将其视为无法连接而关闭，不静默回退到错误作用域。
+ */
+uint16_t
+hev_flow_selected_port (void)
+{
+    return selected_socks_port;
+}
