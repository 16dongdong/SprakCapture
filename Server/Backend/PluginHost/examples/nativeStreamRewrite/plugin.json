{
  "id": "example.nativeStreamRewrite",
  "name": "本地流改写示例",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "native",
  "entry": "dist/nativeStreamRewrite.dll",
  "hooks": [
    "on_connection_open",
    "on_stream_data",
    "on_connection_close"
  ],
  "priority": 100,
  "streamMatch": {
    "hosts": [
      "127.0.0.1"
    ],
    "ports": [
      19081
    ],
    "transports": [
      "tcp",
      "udp"
    ]
  }
}
