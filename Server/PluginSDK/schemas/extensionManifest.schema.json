{
  "$defs": {
    "ContributionKind": {
      "description": "标识插件可以向宿主注册的声明式贡献点。",
      "enum": [
        "settings",
        "commands",
        "inspectorTabs",
        "transactionContextActions",
        "connectionBadges",
        "statusItems",
        "decoders",
        "bodyViewers",
        "mediaRenderers",
        "importers",
        "exporters",
        "workspacePanels"
      ],
      "type": "string"
    },
    "EngineRequirements": {
      "additionalProperties": false,
      "description": "声明插件要求的宿主和扩展 API 版本范围；安装与启用均要重新验证该边界。",
      "properties": {
        "api": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "api"
      ],
      "type": "object"
    },
    "ExtensionLimits": {
      "additionalProperties": false,
      "description": "描述插件作者希望展示的运行参数；宿主仅持久化和诊断，不据此限制可信 Mod。",
      "properties": {
        "maxOutputBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maxPendingEvents": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maxStorageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timeoutMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "timeoutMs",
        "maxPendingEvents",
        "maxOutputBytes",
        "maxStorageBytes"
      ],
      "type": "object"
    },
    "ExtensionMatch": {
      "additionalProperties": false,
      "description": "描述插件订阅的连接、协议和事务范围；空字段表示该维度不限制。",
      "properties": {
        "cidrs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "directions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entries": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "methods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mimeTypes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ports": {
          "default": [],
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "processNames": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "processPaths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocols": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schemes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statusCodes": {
          "default": [],
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "transports": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ExtensionModule": {
      "additionalProperties": false,
      "description": "描述一个插件模块；同一包的模块共享运行时、配置和升级事务。",
      "properties": {
        "contributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContributionKind"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ModuleKind"
        },
        "subscriptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StageSubscription"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ExtensionRuntimeKind": {
      "description": "标识插件作者可自由选择的运行方式；`Native` 允许动态库直接装入代理主进程。",
      "enum": [
        "wasm",
        "sidecar",
        "nativeWorker",
        "native",
        "legacyNative"
      ],
      "type": "string"
    },
    "ExtensionRuntimeManifest": {
      "additionalProperties": false,
      "description": "描述一个插件包的运行入口；入口路径始终相对于已校验的插件版本目录。",
      "properties": {
        "arguments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entry": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExtensionRuntimeKind"
        },
        "protocolVersion": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "entry"
      ],
      "type": "object"
    },
    "FailurePolicy": {
      "description": "描述运行时失败对当前阶段的处理方式；插件作者提供默认值，用户可以按实例覆盖。",
      "enum": [
        "failClosed",
        "failOpen"
      ],
      "type": "string"
    },
    "ModuleKind": {
      "description": "标识插件包内模块的职责；模块类型与运行时相互独立。",
      "enum": [
        "trafficHandler",
        "streamTransformer",
        "protocolDecoder",
        "recordingPolicy",
        "bodyViewer",
        "mediaRenderer",
        "importer",
        "exporter",
        "commandProvider",
        "uiContribution",
        "backgroundService"
      ],
      "type": "string"
    },
    "Stage": {
      "description": "标识宿主发布给插件的稳定处理阶段；枚举值同时作为 RPC、WIT 和控制 API 的线名。",
      "enum": [
        "serviceStarting",
        "serviceStarted",
        "configurationChanged",
        "serviceStopping",
        "connectionAccepted",
        "socks5Authentication",
        "protocolClassified",
        "targetResolving",
        "beforeConnect",
        "connected",
        "connectionClosing",
        "clientHelloObserved",
        "certificateSelecting",
        "tlsEstablished",
        "tlsFailed",
        "requestHeaders",
        "requestBodyChunk",
        "requestComplete",
        "beforeUpstream",
        "responseHeaders",
        "responseBodyChunk",
        "responseComplete",
        "webSocketOpening",
        "webSocketFrame",
        "webSocketClosing",
        "tcpChunk",
        "udpDatagram",
        "dnsMessage",
        "beforeRecord",
        "transactionUpdated",
        "transactionCompleted",
        "recordingCleared",
        "inspectorDataRequested",
        "commandInvoked",
        "contextActionInvoked"
      ],
      "type": "string"
    },
    "StageSubscription": {
      "additionalProperties": false,
      "description": "声明模块对一个稳定阶段的订阅和默认执行顺序。",
      "properties": {
        "match": {
          "$ref": "#/$defs/ExtensionMatch",
          "default": {
            "cidrs": [],
            "directions": [],
            "entries": [],
            "hosts": [],
            "labels": [],
            "methods": [],
            "mimeTypes": [],
            "paths": [],
            "ports": [],
            "processNames": [],
            "processPaths": [],
            "protocols": [],
            "schemes": [],
            "statusCodes": [],
            "transports": []
          }
        },
        "order": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "stage"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "描述完整插件包清单；未知字段拒绝，仅 `extensions` 允许发布者保存命名空间数据。",
  "properties": {
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "configurationSchema": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "contributes": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "engines": {
      "$ref": "#/$defs/EngineRequirements"
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "failurePolicy": {
      "$ref": "#/$defs/FailurePolicy",
      "default": "failClosed"
    },
    "id": {
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ExtensionLimits",
      "default": {
        "maxOutputBytes": 1048576,
        "maxPendingEvents": 128,
        "maxStorageBytes": 67108864,
        "timeoutMs": 50
      }
    },
    "manifestVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ExtensionModule"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/ExtensionRuntimeManifest"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "name",
    "description",
    "version",
    "publisher",
    "engines",
    "runtime",
    "modules",
    "capabilities"
  ],
  "title": "ExtensionManifest",
  "type": "object"
}