{
  "manifestVersion": 2,
  "id": "example.go-jsonl-worker",
  "name": "Go JSONL Worker 示例",
  "description": "使用 Go SDK 的 JSONL v2 生产入口处理阶段事件。",
  "version": "1.0.0",
  "publisher": "examples",
  "engines": { "host": ">=1.0.0", "api": "2.x" },
  "runtime": {
    "kind": "nativeWorker",
    "entry": "dist/goJsonlWorker.exe",
    "protocolVersion": "2.0",
    "arguments": []
  },
  "modules": [{
    "id": "observe",
    "kind": "trafficHandler",
    "subscriptions": [{ "stage": "connectionAccepted", "order": 0, "match": {} }],
    "contributes": []
  }],
  "capabilities": [],
  "dependencies": {},
  "limits": {
    "timeoutMs": 50,
    "maxPendingEvents": 128,
    "maxOutputBytes": 1048576,
    "maxStorageBytes": 67108864
  },
  "failurePolicy": "failClosed"
}
