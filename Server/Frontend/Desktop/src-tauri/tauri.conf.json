{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprak Capture",
  "version": "0.1.0",
  "identifier": "com.sprak.capture",
  "build": {
    "beforeDevCommand": "pnpm --dir ../Web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../Web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sprak Capture 网络代理",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "preventOverflow": true,
        "focusable": true,
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "shadow": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#eef0f3"
      },
      {
        "label": "floating",
        "title": "Sprak Capture 悬浮面板",
        "url": "/floating",
        "width": 340,
        "height": 250,
        "minWidth": 320,
        "minHeight": 230,
        "maxWidth": 420,
        "maxHeight": 320,
        "visible": false,
        "preventOverflow": true,
        "focusable": true,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#eef4ffb8"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Sprak Capture contributors",
    "shortDescription": "网络代理、流量捕获与协议分析工具",
    "longDescription": "统一处理 HTTP、SOCKS5 与 WinDivert 流量，提供实时录制、协议分析和封包规则。",
    "licenseFile": "../../../../LICENSE",
    "resources": {
      "resources/proxyService.exe": "proxyService.exe",
      "resources/accountService.exe": "accountService.exe",
      "resources/clientPackager.exe": "clientPackager.exe",
      "resources/clientTemplate.apk": "clientTemplate.apk",
      "resources/desktopResourceManifest.json": "desktopResourceManifest.json",
      "resources/index.html": "index.html",
      "resources/favicon.svg": "favicon.svg",
      "resources/assets/*": "assets/",
      "resources/assets/toolbar/*": "assets/toolbar/",
      "../../../Backend/ProcessCapture/vendor/LICENSE.WinDivert.txt": "",
      "../../../Backend/ProcessCapture/vendor/WinDivert.dll": "",
      "../../../Backend/ProcessCapture/vendor/WinDivert64.sys": ""
    },
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./windows/installerHooks.nsh"
      }
    }
  }
}
